# =================================================================
# CAMPUSFIX AI - CONFIGURATION
# Built for AWS ShipIt Challenge, Techfest IIT Bombay
# =================================================================

# Security
JWT_SECRET=campusfix-super-secret-jwt-key-2026-techfest-iitb
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local Database
DATABASE_URL=sqlite:///./campusfix.db

# AI Integration (Optional: Set Gemini API Key to enable cloud LLM triage, or leave empty for built-in rule-based NLP)
GEMINI_API_KEY=

# Upload storage directory
UPLOAD_DIR=backend/uploads

# AWS Ready Cloud Deployment (Active when deployed to AWS Lambda / ECS)
USE_AWS_STORAGE=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET=campusfix-evidence-uploads
AWS_DYNAMODB_TABLE=CampusFixComplaints
